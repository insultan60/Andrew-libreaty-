# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Nothing in this file is NEXT_PUBLIC_, and nothing here should be: every one
# of these is read on the server only, and a NEXT_PUBLIC_ prefix would ship it
# to the browser where anyone can read it out of the page source.

# IDX Broker API — server-side only, used by app/api/idx and app/api/photo
# route handlers that proxy requests to https://api.idxbroker.com. Do NOT
# add a NEXT_PUBLIC_ prefix — that would expose it to the browser.
IDX_BROKER_ACCESS_KEY=

# ---------------------------------------------------------------------------
# /dashboard — the private analytics page
# ---------------------------------------------------------------------------

# The only thing standing between the public and the site's traffic data.
# If it is unset the dashboard refuses every request with a 503 rather than
# serving itself openly, so "not configured" means "nobody gets in".
# Use a DIFFERENT value in production from the one in local .env.local.
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Analytics sources. All optional: with none of them set, /dashboard still
# renders its full layout with every figure at zero and says in words that the
# zeros are a setup state rather than a traffic finding.
# ---------------------------------------------------------------------------

# The GA4 measurement ID (G-XXXXXXXXXX) that the GTM container in
# app/layout.tsx fires. Open tagmanager.google.com, find the GA4 configuration
# tag, copy the ID out of it.
#
# Setting this does NOT install a tag. The container already tags every page;
# a second tag beside it would double-count every session. This only records
# which stream is live so the Connections panel can stop guessing.
GA4_MEASUREMENT_ID=

# Numeric property ID, from analytics.google.com → Admin → Property details.
# This is a number. It is NOT the G- measurement ID above; both exist and they
# are used for different things.
GA4_PROPERTY_ID=

# Exactly as Search Console lists the property:
#   sc-domain:andrewliberty.com        for a domain property
#   https://andrewliberty.com/         for a URL-prefix one (trailing slash)
GSC_SITE_URL=

# Service account from console.cloud.google.com → IAM → Service Accounts.
# Enable the "Google Analytics Data API" and the "Search Console API" on that
# project, then grant the account Viewer on the GA4 property AND add it under
# Search Console → Settings → Users and permissions. Skipping that last step
# is what produces a 403 when every key here is already correct.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key from the service account JSON, in quotes, with the literal
# backslash-n line breaks left exactly as they appear in that file.
GOOGLE_PRIVATE_KEY=""

# Dropbox app key for listing video tours (app/[slug]/VideoTour.tsx).
# Create an app at https://www.dropbox.com/developers/apps and add the site's
# domains under "Chooser / Saver / Embedder domains". Leave empty to hide videos.
NEXT_PUBLIC_DROPBOX_APP_KEY=
